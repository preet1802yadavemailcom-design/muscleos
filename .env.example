# MuscleOS Environment Configuration
NODE_ENV=development

# Database
DB_USER=muscleos
DB_PASSWORD=muscleos_secret_2024
DB_NAME=muscleos
DB_PORT=5432
DATABASE_URL=postgresql://muscleos:muscleos_secret_2024@localhost:5432/muscleos?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# API
API_PORT=3000
FRONTEND_URL=http://localhost:5173

# Frontend
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000/api/v1

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=rzp_test_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx

STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MuscleOS <no-reply@muscleos.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Error Tracking (leave empty to disable Sentry)
SENTRY_DSN=

# Cookies
COOKIE_SECRET=your_super_secret_cookie_key

# Automated Backups (Module 15 — scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
